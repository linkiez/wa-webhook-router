# SQS Consumer Configuration
QUEUE_URL=https://sqs.us-east-1.amazonaws.com/523566111264/Chatwoot-Meta-Queue
AWS_REGION=us-east-1

# AWS Credentials (if not using AWS CLI profile)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Routing Configuration
# Comma-separated list to fan out relative paths to multiple hosts
DESTINATION_HOST=http://localhost:3001,http://backup-host:3002
# Each entry is phone::path[::token], separated by |
# Token is optional - if provided, will be sent as Authorization: Bearer {token}
# Repeat the same phone number to forward its messages to multiple destinations
PHONE_ROUTES=5511999999999::/webhooks/meta::optional-token|5511999999999::/webhooks/backup|5511888888888::/webhooks/whatsapp
